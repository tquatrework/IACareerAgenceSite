{{-- Textes : content/audit.yml. Ici, seulement la structure. --}}
@layouts.app({
  title: pages.audit.meta.title,
  description: pages.audit.meta.description,
  path: '/audit-transformation'
})
  @pageHead({ eyebrow: pages.audit.head.eyebrow, title: pages.audit.head.title, lead: pages.audit.head.lead })
    @slot('actions')
      <a class="button button--primary" href="/contact?objet=audit">{{ pages.audit.head.button }}</a>
    @end
  @end
  <section class="section"><div class="wrap">
    @!sectionHead({ marker: '01', title: pages.audit.dimensions.title })
    <div class="split">
      @each(dimension in pages.audit.dimensions.items)
        <article class="split__item"><h3>{{ dimension.title }}</h3>
          @!ticks({ items: dimension.ticks })
        </article>
      @end
    </div>
  </div></section>
  <section class="section section--ruled"><div class="wrap">
    @!sectionHead({ marker: '02', title: pages.audit.deliverables.title })
    @!ticks({ items: pages.audit.deliverables.ticks })
  </div></section>
  <section class="section"><div class="wrap">
    @!sectionHead({ marker: '03', title: pages.audit.method.title })
    @!stepList({ steps: pages.audit.method.steps.map((step) => [step.title, step.text]) })
  </div></section>
  <section class="section section--ruled"><div class="wrap">
    @!sectionHead({ marker: '04', title: pages.audit.levels.title, lead: pages.audit.levels.lead })
    <div class="levels">
      <article><h3>{{ pages.audit.levels.questionnaire.title }}</h3><p>{{ pages.audit.levels.questionnaire.before }} <a href="/">{{ pages.audit.levels.questionnaire.linkLabel }}</a>{{ pages.audit.levels.questionnaire.after }}</p></article>
      @each(level in pages.audit.levels.items)
        <article><h3>{{ level.title }}</h3><p>{{ level.text }}</p></article>
      @end
    </div>
    <p class="muted note">{{ pages.audit.levels.note }}</p>
  </div></section>
  @!quoteCta({ text: pages.audit.cta.text, params: '?objet=audit' })
@end
