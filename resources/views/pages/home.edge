{{-- Textes : content/home.yml. Ici, seulement la structure et l'ordre des sections. --}}
@layouts.app({
  title: home.meta.title,
  description: home.meta.description,
  path: '/',
  scripts: ['/js/quiz.js'],
  bodyClass: 'is-home'
})
  <section class="hero" aria-labelledby="hero-title">
    <div class="wrap hero__grid">
      <div class="hero__quiz">
        <p class="eyebrow"><span class="marker">{{ home.hero.eyebrow }}</span></p>
        <h1 class="display" id="hero-title">{{ home.hero.title }}</h1>
        <p class="lead">{{ home.hero.lead }}</p>
        <div class="quiz" id="quiz" data-quiz aria-live="polite">
          <noscript>
            <p class="notice">{{ home.hero.noscript }}</p>
          </noscript>
        </div>
        <p class="hero__skip"><a href="/solutions">{{ home.hero.skipLink }}</a></p>
      </div>
      <div class="hero__mosaic">
        <h2 class="visually-hidden">Cartes de solutions</h2>
        <p class="mosaic-status" id="mosaic-status" role="status"></p>
        <ul class="mosaic" id="mosaic" data-mosaic></ul>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="realisations">
    <div class="wrap">
      @!sectionHead({ marker: '01', title: home.realisations.title, id: 'realisations', lead: home.realisations.lead })
      <ul class="realisations">
        @each(item in realisations)
          <li class="realisation">
            <p class="tag">{{ item.nature }}</p>
            <h3><a href="/realisations/{{ item.slug }}">{{ item.title }}</a></h3>
            <p class="muted">{{ item.status }}</p>
            <p>{{ item.summary }}</p>
          </li>
        @end
      </ul>
      <a class="text-link" href="/realisations">{{ home.realisations.allLink }}</a>
    </div>
  </section>

  <section class="section section--ruled" aria-labelledby="qualite">
    <div class="wrap">
      @!sectionHead({ marker: '02', title: home.quality.title, id: 'qualite' })
      <ul class="quality-list">
        @each(point in home.quality.points)
          <li>
            @!familyIcon({ family: 'audit' })
            <div><h3>{{ point.title }}</h3><p>{{ point.text }}</p></div>
          </li>
        @end
      </ul>
      <a class="text-link" href="/qualite-confiance">{{ home.quality.link }}</a>
    </div>
  </section>

  <section class="quote-band" aria-label="Citation">
    <div class="wrap quote-band__grid">
      <blockquote class="quote-band__quote">
        <p>{{ home.quote.text }}</p>
      </blockquote>
      <div class="quote-band__action"><a class="button button--primary" href="/contact">{{ home.quote.button }}</a></div>
    </div>
  </section>

  <section class="section" aria-labelledby="methode">
    <div class="wrap">
      @!sectionHead({ marker: '03', title: home.method.title, id: 'methode' })
      @!stepList({ steps: home.method.steps.map((step) => [step.title, step.text]) })
      <p class="deliverables"><strong>{{ home.method.deliverablesLabel }}</strong> {{ home.method.deliverables }}</p>
      <a class="text-link" href="/audit-transformation">{{ home.method.link }}</a>
    </div>
  </section>

  <section class="section section--ruled" aria-labelledby="publics">
    <div class="wrap">
      @!sectionHead({ marker: '04', title: home.publics.title, id: 'publics' })
      <div class="split">
        @each(audience in home.publics.items)
          <article class="split__item">
            <h3>{{ audience.title }}</h3>
            <p>{{ audience.text }}</p>
            @!ticks({ items: audience.ticks })
            <a class="text-link" href="{{ audience.linkHref }}">{{ audience.linkLabel }}</a>
          </article>
        @end
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="deux-facons">
    <div class="wrap">
      @!sectionHead({ marker: '05', title: home.paths.title, id: 'deux-facons' })
      <div class="split">
        @each(path in home.paths.items)
          <article class="split__item">
            <h3>{{ path.title }}</h3>
            <p>{{ path.text }}</p>
            <a class="text-link" href="{{ path.linkHref }}">{{ path.linkLabel }}</a>
          </article>
        @end
      </div>
      <p class="muted note">{{ home.paths.note }}</p>
    </div>
  </section>

  <section class="section final-invite" aria-labelledby="invitation">
    <div class="wrap">
      <h2 class="headline" id="invitation">{{ home.invitation.title }}</h2>
      <div class="actions"><a class="button button--primary" href="/contact">{{ home.invitation.button }}</a></div>
      <p class="muted">{{ home.invitation.trainingText }}
        <a href="{{ site.trainingUrl }}">{{ home.invitation.trainingLinkLabel }}</a>.</p>
    </div>
  </section>
@end
