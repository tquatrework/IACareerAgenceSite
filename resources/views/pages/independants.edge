{{-- Textes : content/independants.yml (packs : content/offers.yml). Ici, seulement la structure. --}}
@layouts.app({
  title: pages.independants.meta.title,
  description: pages.independants.meta.description,
  path: '/solutions-independants'
})
  @pageHead({ eyebrow: pages.independants.head.eyebrow, title: pages.independants.head.title, lead: pages.independants.head.lead })
    @slot('actions')
      <a class="button button--primary" href="/contact">{{ pages.independants.head.button }}</a>
    @end
  @end
  <section class="section"><div class="wrap">
    @!sectionHead({ marker: '·', title: pages.independants.recognize.title })
    @!ticks({ items: pages.independants.recognize.ticks })
    <p>{{ pages.independants.recognize.paragraph }}</p>
  </div></section>
  <section class="section section--ruled"><div class="wrap">
    @!sectionHead({ marker: '·', title: pages.independants.packs.title })
    <ul class="teasers">
      @each(offer in offers.filter((item) => item.audience === 'independant'))
        <li class="teaser">
          <p class="eyebrow">{{ offer.kind }}</p>
          <h3><a href="/solutions/{{ offer.slug }}">{{ offer.title }}</a></h3>
          <p>{{ offer.summary }}</p>
        </li>
      @end
    </ul>
    <p class="muted note">{{ pages.independants.packs.note }}</p>
    <a class="text-link" href="/solutions">{{ pages.independants.packs.allLink }}</a>
  </div></section>
  @!quoteCta()
@end
