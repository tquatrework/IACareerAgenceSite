{{-- Textes de la fiche : content/offers.yml (offres et intitulés de la rubrique « page »). --}}
@layouts.app({
  title: offer.title,
  description: (offer.summary + ' ' + offer.problem).slice(0, 240),
  path: '/solutions/' + offer.slug
})
  @pageHead({ eyebrow: offer.kind + ' · ' + offersPage.audienceLabels[offer.audience], title: offer.title, lead: offer.summary })
    @slot('actions')
      <a class="button button--primary" href="/contact?solution={{ offer.slug }}">{{ offersPage.buttonPrefix }} {{ offer.kind.toLowerCase() }}</a>
    @end
  @end
  <section class="section"><div class="wrap fiche">
    <div class="fiche__row"><h2 class="subhead">{{ offersPage.problemTitle }}</h2><p>{{ offer.problem }}</p></div>
    <div class="fiche__row"><h2 class="subhead">{{ offersPage.concernedTitle }}</h2><p>{{ offer.concerned }}</p></div>
    <div class="fiche__row"><h2 class="subhead">{{ offersPage.receivesTitle }}</h2>@!ticks({ items: offer.receives })</div>
    <div class="fiche__row"><h2 class="subhead">{{ offersPage.toolsTitle }}</h2>@!ticks({ items: offer.tools })</div>
    <div class="fiche__row"><h2 class="subhead">{{ offersPage.inScopeTitle }}</h2>@!ticks({ items: offer.inScope })</div>
    <div class="fiche__row"><h2 class="subhead">{{ offersPage.adaptationTitle }}</h2>@!ticks({ items: offer.adaptation })</div>
    <div class="fiche__row"><h2 class="subhead">{{ offersPage.validationsTitle }}</h2>@!ticks({ items: offer.validations })</div>
    <div class="fiche__row"><h2 class="subhead">{{ offersPage.supportTitle }}</h2><p>{{ offersPage.supportText }}</p></div>
    <div class="fiche__row"><h2 class="subhead">{{ offersPage.priceTitle }}</h2><p><strong>{{ offersPage.priceLead }}</strong> {{ offersPage.priceText }}</p></div>
    <div class="fiche__row"><h2 class="subhead">{{ offersPage.associatedTitle }}</h2><p>{{ offersPage.associatedText }} <a href="/realisations">{{ offersPage.associatedLink }}</a>.</p></div>
    <div class="fiche__row"><h2 class="subhead">{{ offersPage.cardsTitle }}</h2>
      <ul class="ticks">
        @each(card in cardsFor(offer))
          <li><a href="/solutions#{{ card.slug }}">{{ card.title }}</a></li>
        @end
      </ul>
    </div>
  </div></section>
  @!quoteCta({ text: offersPage.ctaText, params: '?solution=' + offer.slug })
  <div class="wrap back-link"><a class="text-link" href="{{ offer.audience === 'pme' ? '/solutions-pme' : '/solutions-independants' }}">{{ offersPage.backLink }}</a></div>
@end
