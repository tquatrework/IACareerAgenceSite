{{-- Textes : content/pme.yml (familles : content/offers.yml). Ici, seulement la structure. --}}
@layouts.app({
  title: pages.pme.meta.title,
  description: pages.pme.meta.description,
  path: '/solutions-pme'
})
  @pageHead({ eyebrow: pages.pme.head.eyebrow, title: pages.pme.head.title, lead: pages.pme.head.lead })
    @slot('actions')
      <a class="button button--primary" href="/contact">{{ pages.pme.head.button }}</a>
    @end
  @end
  <section class="section"><div class="wrap">
    @!sectionHead({ marker: '·', title: pages.pme.contexts.title })
    <p>{{ pages.pme.contexts.paragraph }}</p>
    @!ticks({ items: pages.pme.contexts.ticks })
    <dl class="glossary">
      @each(entry in pages.pme.contexts.glossary)
        <dt>{{ entry.term }}</dt><dd>{{ entry.definition }}</dd>
      @end
    </dl>
  </div></section>
  <section class="section section--ruled"><div class="wrap">
    @!sectionHead({ marker: '·', title: pages.pme.families.title })
    <ul class="teasers">
      @each(offer in offers.filter((item) => item.audience === 'pme'))
        <li class="teaser">
          <p class="eyebrow">{{ offer.kind }}</p>
          <h3><a href="/solutions/{{ offer.slug }}">{{ offer.title }}</a></h3>
          <p>{{ offer.summary }}</p>
        </li>
      @end
    </ul>
    <p class="muted note">{{ pages.pme.families.note }}</p>
    <a class="text-link" href="/solutions">{{ pages.pme.families.allLink }}</a>
  </div></section>
  @!quoteCta()
@end
