{{-- Textes : content/qualite.yml. Ici, seulement la structure : chaque bloc de « sections » est numéroté dans l'ordre. --}}
@layouts.app({
  title: pages.qualite.meta.title,
  description: pages.qualite.meta.description,
  path: '/qualite-confiance'
})
  @pageHead({ eyebrow: pages.qualite.head.eyebrow, title: pages.qualite.head.title, lead: pages.qualite.head.lead })
  @end
  @each((section, index) in pages.qualite.sections)
    <section class="section {{ index % 2 === 1 ? 'section--ruled' : '' }}"><div class="wrap">
      @!sectionHead({ marker: padNumber(index + 1), title: section.title, lead: section.lead })
      @if(section.ticks)
        @!ticks({ items: section.ticks })
      @end
      @if(section.columns)
        <div class="split">
          @each(column in section.columns)
            <article class="split__item"><h3>{{ column.title }}</h3><p>{{ column.text }}</p></article>
          @end
        </div>
      @end
      @if(section.notice)
        <p class="notice">{{ section.notice }}</p>
      @end
      @if(section.note)
        <p class="muted note">{{ section.note }}</p>
      @end
    </div></section>
  @end
  @!quoteCta()
@end
