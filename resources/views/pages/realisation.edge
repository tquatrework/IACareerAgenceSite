{{-- Textes : content/realisations.yml. Ici, seulement la structure. --}}
@layouts.app({
  title: realisation.title,
  description: realisation.title + ' : ' + realisationsPages.detail.descriptionSuffix,
  path: '/realisations/' + realisation.slug,
  noindex: true
})
  @pageHead({ eyebrow: realisation.nature, title: realisation.title, lead: realisation.status + '. ' + realisationsPages.detail.leadSuffix })
    @slot('actions')
      <a class="button button--primary" href="/contact?objet=solution">{{ realisationsPages.detail.button }}</a>
    @end
  @end
  <section class="section"><div class="wrap">
    @!sectionHead({ title: realisationsPages.detail.sectionTitle })
    @!ticks({ items: ficheSections })
    <a class="text-link" href="/realisations">{{ realisationsPages.detail.backLink }}</a>
  </div></section>
@end
