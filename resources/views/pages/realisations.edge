{{-- Textes : content/realisations.yml. Ici, seulement la structure. --}}
@layouts.app({
  title: realisationsPages.list.meta.title,
  description: realisationsPages.list.meta.description,
  path: '/realisations'
})
  @pageHead({ eyebrow: realisationsPages.list.head.eyebrow, title: realisationsPages.list.head.title, lead: realisationsPages.list.head.lead })
  @end
  <section class="section"><div class="wrap">
    <ul class="realisations realisations--wide">
      @each(item in realisations)
        <li class="realisation">
          <p class="tag">{{ item.nature }}</p>
          <h2 class="subhead"><a href="/realisations/{{ item.slug }}">{{ item.title }}</a></h2>
          <p class="muted">{{ item.theme }} · {{ item.status }}</p>
          <p>{{ item.summary }}</p>
        </li>
      @end
    </ul>
    <p class="muted note">{{ realisationsPages.list.note }}</p>
  </div></section>
  @!quoteCta()
@end
