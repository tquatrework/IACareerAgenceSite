{{-- Textes de la page : content/solutions.yml. Titres et résumés des cartes : public/js/shared/catalog.js. --}}
@layouts.app({
  title: pages.solutions.meta.title,
  description: pages.solutions.meta.description,
  path: '/solutions'
})
  @pageHead({ eyebrow: pages.solutions.head.eyebrow, title: pages.solutions.head.title, lead: pages.solutions.head.lead })
  @end
  <section class="section"><div class="wrap">
    @each((label, key) in families)
      <section class="family" aria-labelledby="fam-{{ key }}">
        <h2 class="subhead" id="fam-{{ key }}">{{ label }}</h2>
        <ul class="catalog">
          @each(card in cards.filter((item) => item.family === key))
            <li class="catalog-entry" id="{{ card.slug }}">
              <span class="catalog-entry__num" aria-hidden="true">{{ padNumber(card.id) }}</span>
              <div>
                <p class="eyebrow">{{ label }}</p>
                <h3>{{ card.title }}</h3>
                <p>{{ card.summary }}</p>
                <p class="catalog-entry__links"><a href="{{ cardHref(card) }}">{{ pages.solutions.cardLinks.details }}</a>
                  <a href="/contact?solution={{ card.slug }}">{{ pages.solutions.cardLinks.quote }}</a></p>
              </div>
            </li>
          @end
        </ul>
      </section>
    @end
    <dl class="glossary">
      @each(entry in pages.solutions.glossary)
        <dt>{{ entry.term }}</dt><dd>{{ entry.definition }}</dd>
      @end
    </dl>
  </div></section>
  @!quoteCta()
@end
