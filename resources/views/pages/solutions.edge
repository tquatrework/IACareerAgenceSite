@layouts.app({
  title: 'Toutes les solutions',
  description: 'Le catalogue des trente types de solutions IA proposés par IACareer pour les indépendants et les PME.',
  path: '/solutions'
})
  @pageHead({ eyebrow: 'Toutes les solutions', title: 'Trente types de solutions, à combiner.', lead: 'Ces cartes représentent des types de solutions, pas trente packs indépendants : certaines sont des briques d’un même projet. Un traitement de mails peut alimenter un CRM et un tableau de bord ; un chatbot peut s’appuyer sur un RAG.' })
  @end
  <section class="section"><div class="wrap">
    @each((label, key) in families)
      <section class="family" aria-labelledby="fam-{{ key }}">
        <h2 class="subhead" id="fam-{{ key }}">{{ label }}</h2>
        <ul class="catalog">
          @each(card in cards.filter((item) => item.family === key))
            <li class="catalog-entry" id="{{ card.slug }}">
              <span class="catalog-entry__num" aria-hidden="true">{{ padNumber(card.id) }}</span>
              <div>
                <p class="eyebrow">{{ label }}</p>
                <h3>{{ card.title }}</h3>
                <p>{{ card.summary }}</p>
                <p class="catalog-entry__links"><a href="{{ cardHref(card) }}">Voir la présentation détaillée</a>
                  <a href="/contact?solution={{ card.slug }}">Demander un devis pour cette solution</a></p>
              </div>
            </li>
          @end
        </ul>
      </section>
    @end
    <dl class="glossary">
      <dt>SEO / GEO</dt><dd>Être trouvé dans les moteurs de recherche (SEO) et cité par les moteurs d’IA (GEO).</dd>
      <dt>CRM</dt><dd>Outil de suivi des clients et des prospects.</dd>
      <dt>RAG</dt><dd>Réponses élaborées à partir de vos documents, avec les sources.</dd>
      <dt>MCP / API</dt><dd>Moyens de connecter des assistants IA à vos logiciels.</dd>
    </dl>
  </div></section>
  @!quoteCta()
@end
